OPENAI_API_KEY=
# Legacy display/fallback model. Paid stages use the profile-specific models below.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
PROCESSING_PROFILE=balanced
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_QUALITY_MODEL=gpt-5.6-sol
OPENAI_ECONOMY_REASONING_EFFORT=low
OPENAI_ANALYSIS_REASONING_EFFORT=medium
OPENAI_REVIEW_REASONING_EFFORT=medium
OPENAI_QUALITY_REASONING_EFFORT=high
AGENT_MODE=openai
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_FILE_MB=50
MAX_JOB_MB=250
MAX_AGENT_STEPS=8
MAX_AGENT_SECONDS=900
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=4000
OPENAI_EXACT_TOKEN_PREFLIGHT=true
# Keep false for a fail-closed budget. Set true only to explicitly allow a local estimate when token counting is unavailable.
ALLOW_APPROXIMATE_TOKEN_PREFLIGHT=false
MAX_INPUT_TOKENS_PER_CALL=100000
MAX_JOB_INPUT_TOKENS=400000
MAX_JOB_COST_USD=2.00
MAX_MODEL_CALLS_PER_JOB=8
MAX_SOURCE_CHARS_PER_READ=18000
MAX_SOURCE_PAGES_PER_READ=8
MAX_SOURCE_CHARS_PER_JOB=70000
SOFFICE_PATH=soffice
